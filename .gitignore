# Dataset
# Raw FaceForensics++ dataset is ignored.
# Metadata CSVs and official train/val/test splits are version-controlled.

data/raw/

# Metadata
data/metadata/*
!data/metadata/.gitkeep
!data/metadata/master_metadata.csv

# Dataset Splits
data/splits/*
!data/splits/.gitkeep
!data/splits/train.csv
!data/splits/validation.csv
!data/splits/test.csv

# Processed face-image dataset (regenerable from data/raw via src/dataset)
data/processed/*
!data/processed/.gitkeep

# Local sample data
data/sample/*
!data/sample/.gitkeep

# Kaggle-downloaded processed dataset used by Lab 12 / Lab 14
data/kaggle_processed/

# Generated outputs (frames, face crops, checkpoints, logs, predictions, graphs)
outputs/*/*
!outputs/*/.gitkeep

# Zip files
*.zip

# Python cache
__pycache__/
*.pyc

# Jupyter checkpoints
.ipynb_checkpoints/

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db